    "db:seed": "tsx scripts/seed.ts"
  },
  "dependencies": {
    "@astrojs/node": "^9.5.1",
    "@tailwindcss/vite": "^4.1.18",
    "arctic": "^3.7.0",
    "astro": "^5.16.6",
    "better-sqlite3": "^12.5.0",
    "drizzle-orm": "^0.45.1",
    "file-type": "^21.3.4",
    "leaflet": "^1.9.4",
    "prom-client": "^15.1.3",
    "tailwindcss": "^4.1.18"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.4.15",
    "@types/better-sqlite3": "^7.6.13",
    "@types/leaflet": "^1.9.21",
    "drizzle-kit": "^0.31.8",
    "tsx": "^4.21.0",
    "typescript": "^6.0.3",
