# Light the Ham! Environment Variables
# Copy this to .env and fill in your values

# Site URL (used for OAuth callbacks)
SITE_URL=http://localhost:4321

# Database (optional - defaults to data/lighttheham.db)
DATABASE_URL=data/lighttheham.db

# ============================================================
# OAUTH CREDENTIALS
# ============================================================

# Google OAuth
# Get credentials at: https://console.cloud.google.com/apis/credentials
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Google Maps Geocoding API (for address lookup)
# Enable at: https://console.cloud.google.com/apis/library/geocoding-backend.googleapis.com
# Pricing: $5/1,000 requests (first 10k/month may be free)
GOOGLE_MAPS_API_KEY=

# Apple Sign In
# Get credentials at: https://developer.apple.com/account/resources/identifiers
# Requires Apple Developer account ($99/year)
APPLE_CLIENT_ID=
APPLE_TEAM_ID=
APPLE_KEY_ID=
APPLE_PRIVATE_KEY=

# Facebook OAuth
# Get credentials at: https://developers.facebook.com/apps
FACEBOOK_CLIENT_ID=
FACEBOOK_CLIENT_SECRET=
