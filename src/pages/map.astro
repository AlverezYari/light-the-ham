---
/**
 * Map Page - "/map"
 *
 * Full-screen interactive map showing all approved properties.
 */
export const prerender = false;

import BaseLayout from '../layouts/BaseLayout.astro';
import PropertyMap from '../components/PropertyMap.astro';
import { db, properties, seasons, featureTags } from '../lib/db';
import { eq, and, count } from 'drizzle-orm';

// Get property count for display
const currentSeason = await db
  .select()
  .from(seasons)
  .where(eq(seasons.status, 'active'))
  .limit(1);

let propertyCount = 0;
if (currentSeason.length > 0) {
  const result = await db
    .select({ count: count() })
    .from(properties)
    .where(
      and(
        eq(properties.seasonId, currentSeason[0].id),
        eq(properties.status, 'approved')
      )
    );
  propertyCount = result[0]?.count || 0;
}

// Get unique cities for filter
const cities = await db
  .selectDistinct({ city: properties.city })
  .from(properties)
  .where(eq(properties.status, 'approved'));

// Get all feature tags for filtering
const allFeatures = await db
  .select({
    slug: featureTags.slug,
    name: featureTags.name,
    icon: featureTags.icon,
    category: featureTags.category,
  })
  .from(featureTags)
  .orderBy(featureTags.category, featureTags.sortOrder);

// Get current filter from URL
const currentFeatures = Astro.url.searchParams.get('features')?.split(',').filter(Boolean) || [];
---

<BaseLayout title="Map | Light the Ham!">
  <!-- Header Bar -->
  <div class="bg-slate-800 border-b border-slate-700 px-4 py-3">
    <div class="mx-auto max-w-7xl flex flex-col gap-3">
      <div class="flex items-center justify-between">
        <div>
          <h1 class="text-xl font-bold">Christmas Light Map</h1>
          <p class="text-sm text-slate-400">
            <span id="display-count">{propertyCount}</span> {propertyCount === 1 ? 'display' : 'displays'} in the Greater Birmingham Metro Area
          </p>
        </div>

        <!-- Search + City Filter + Add Button -->
        <div class="flex items-center gap-3">
          <div class="relative">
            <input
              type="text"
              id="search-input"
              placeholder="Search displays..."
              class="bg-slate-700 border border-slate-600 rounded px-3 py-1.5 pl-8 text-sm focus:border-amber-500 focus:outline-none w-48"
            />
            <svg class="absolute left-2.5 top-1/2 -translate-y-1/2 w-4 h-4 text-slate-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z"></path>
            </svg>
          </div>

          <select
            id="city-filter"
            class="bg-slate-700 border border-slate-600 rounded px-3 py-1.5 text-sm focus:border-amber-500 focus:outline-none"
          >
            <option value="">All Cities</option>
            {cities.map((c) => (
              <option value={c.city}>{c.city}</option>
            ))}
          </select>

          <a
            href="/submit"
            class="bg-amber-500 hover:bg-amber-600 text-slate-900 font-medium px-4 py-1.5 rounded text-sm whitespace-nowrap"
          >
            + Add Display
          </a>
        </div>
      </div>

      <!-- Feature Filters -->
      <div class="flex flex-wrap gap-2" id="feature-filters">
        {allFeatures.map((feature) => (
          <button
            class:list={[
              'feature-chip px-3 py-1 rounded-full text-sm font-medium transition-colors',
              currentFeatures.includes(feature.slug)
                ? 'bg-amber-500 text-slate-900'
                : 'bg-slate-700 text-slate-300 hover:bg-slate-600'
            ]}
            data-slug={feature.slug}
          >
            {feature.icon} {feature.name}
          </button>
        ))}
        {currentFeatures.length > 0 && (
          <button
            id="clear-filters"
            class="px-3 py-1 rounded-full text-sm font-medium bg-red-500/20 text-red-400 hover:bg-red-500/30"
          >
            Clear All
          </button>
        )}
      </div>
    </div>
  </div>

  <!-- Map Container - Fixed height -->
  <div style="height: 600px; width: 100%;">
    <PropertyMap />
  </div>

  <!-- Legend -->
  <div class="bg-slate-800 border-t border-slate-700 px-4 py-2">
    <div class="mx-auto max-w-7xl flex items-center gap-6 text-sm">
      <div class="flex items-center gap-2">
        <span class="inline-block w-4 h-4 bg-amber-500 rounded-full"></span>
        <span class="text-slate-400">Display</span>
      </div>
      <div class="flex items-center gap-2">
        <span class="inline-block w-4 h-4 bg-green-500 rounded-full"></span>
        <span class="text-slate-400">Top Rated</span>
      </div>
      <div class="flex items-center gap-2">
        <span class="inline-block w-4 h-4 bg-red-500 rounded-full"></span>
        <span class="text-slate-400">Featured</span>
      </div>
    </div>
  </div>
</BaseLayout>

<script>
  // Get current URL params
  const params = new URLSearchParams(window.location.search);

  // Search functionality
  const searchInput = document.getElementById('search-input') as HTMLInputElement;
  let searchTimeout: ReturnType<typeof setTimeout>;

  if (searchInput) {
    // Set initial value from URL
    const searchParam = params.get('q');
    if (searchParam) {
      searchInput.value = searchParam;
    }

    searchInput.addEventListener('input', () => {
      clearTimeout(searchTimeout);
      searchTimeout = setTimeout(() => {
        updateFilters();
      }, 300); // Debounce 300ms
    });

    // Enter key triggers immediate search
    searchInput.addEventListener('keydown', (e) => {
      if (e.key === 'Enter') {
        clearTimeout(searchTimeout);
        updateFilters();
      }
    });
  }

  // City filter functionality
  const cityFilter = document.getElementById('city-filter') as HTMLSelectElement;
  if (cityFilter) {
    // Set initial value from URL
    const cityParam = params.get('city');
    if (cityParam) {
      cityFilter.value = cityParam;
    }

    cityFilter.addEventListener('change', () => {
      updateFilters();
    });
  }

  // Feature filter functionality
  const featureChips = document.querySelectorAll('.feature-chip');
  const clearFiltersBtn = document.getElementById('clear-filters');

  featureChips.forEach((chip) => {
    chip.addEventListener('click', () => {
      const slug = (chip as HTMLElement).dataset.slug;
      if (!slug) return;

      const currentFeatures = params.get('features')?.split(',').filter(Boolean) || [];

      if (currentFeatures.includes(slug)) {
        // Remove feature
        const newFeatures = currentFeatures.filter(f => f !== slug);
        if (newFeatures.length > 0) {
          params.set('features', newFeatures.join(','));
        } else {
          params.delete('features');
        }
      } else {
        // Add feature
        currentFeatures.push(slug);
        params.set('features', currentFeatures.join(','));
      }

      updateFilters();
    });
  });

  clearFiltersBtn?.addEventListener('click', () => {
    params.delete('features');
    updateFilters();
  });

  function updateFilters() {
    // Search
    const searchValue = searchInput?.value?.trim();
    if (searchValue) {
      params.set('q', searchValue);
    } else {
      params.delete('q');
    }

    // City
    const city = cityFilter?.value;
    if (city) {
      params.set('city', city);
    } else {
      params.delete('city');
    }

    const queryString = params.toString();
    window.location.href = '/map' + (queryString ? '?' + queryString : '');
  }
</script>
