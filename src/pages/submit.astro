---
/**
 * Property Submission Page - "/submit"
 *
 * Form for users to submit new Christmas light displays.
 * Uses SSR for form handling.
 */
export const prerender = false;

import BaseLayout from '../layouts/BaseLayout.astro';
import { getSessionFromCookies, validateSession } from '../lib/auth';
import { db, featureTags } from '../lib/db';

// Check if user is logged in (needed for owner claims)
const cookieHeader = Astro.request.headers.get('cookie');
const sessionToken = getSessionFromCookies(cookieHeader);
const session = sessionToken ? await validateSession(sessionToken) : null;
const user = session?.user || null;

// Fetch feature tags for the form
const tags = await db.select().from(featureTags).orderBy(featureTags.sortOrder);

// Group tags by category for better UX
const tagsByCategory = tags.reduce(
  (acc, tag) => {
    const category = tag.category || 'other';
    if (!acc[category]) acc[category] = [];
    acc[category].push(tag);
    return acc;
  },
  {} as Record<string, typeof tags>,
);

const categoryLabels: Record<string, string> = {
  audio: '🎵 Audio',
  visual: '✨ Visual',
  interactive: '🎅 Interactive',
  access: '🚗 Access',
  audience: '👨‍👩‍👧 Audience',
  community: '❤️ Community',
  style: '🎨 Style',
  theme: '🎄 Theme',
  recognition: '🏆 Recognition',
  other: '📌 Other',
};
---

<BaseLayout title="Submit a Display | Light the Ham!">
