<script>
  /**
   * Client-side form handling
   *
   * This script runs in the browser (not on the server).
   * It handles:
   * 1. Photo preview
   * 2. Form submission via fetch API with progress
   * 3. Success/error display
   */

  const form = document.getElementById('submit-form') as HTMLFormElement;
  const photosInput = document.getElementById('photos') as HTMLInputElement;
  const photoPreview = document.getElementById('photo-preview') as HTMLDivElement;
  const submitBtn = document.getElementById('submit-btn') as HTMLButtonElement;
  const successMsg = document.getElementById('success-message') as HTMLDivElement;
  const errorMsg = document.getElementById('error-message') as HTMLDivElement;
  const errorText = document.getElementById('error-text') as HTMLSpanElement;
  const progressContainer = document.getElementById('progress-container') as HTMLDivElement;
  const progressStatus = document.getElementById('progress-status') as HTMLSpanElement;
  const progressBar = document.getElementById('progress-bar') as HTMLDivElement;
  const progressDetail = document.getElementById('progress-detail') as HTMLDivElement;
  const addressInput = document.getElementById('address') as HTMLInputElement;
  const addressSuggestions = document.getElementById('address-suggestions') as HTMLDivElement;
  const citySelect = document.getElementById('city') as HTMLSelectElement;
  const zipSelect = document.getElementById('zip') as HTMLSelectElement;
  const ownerLoginPrompt = document.getElementById('owner-login-prompt') as HTMLDivElement;

  // Get user state from form data attributes
  const isLoggedIn = form.dataset.loggedIn === 'true';
  const userId = form.dataset.userId || null;

  // Handle contributor type selection - show login prompt if owner selected without login
  const contributorRadios = document.querySelectorAll('input[name="contributorType"]');
  contributorRadios.forEach((radio) => {
    radio.addEventListener('change', (e) => {
      const value = (e.target as HTMLInputElement).value;
      if (value === 'owner' && !isLoggedIn) {
        ownerLoginPrompt.classList.remove('hidden');
        submitBtn.disabled = true;
      } else {
        ownerLoginPrompt.classList.add('hidden');
        submitBtn.disabled = false;
      }
    });
  });

  // Progress helper
  function updateProgress(status: string, percent: number, detail = '') {
    progressStatus.textContent = status;
    progressBar.style.width = `${percent}%`;
    progressDetail.textContent = detail;
  }

  // Address autocomplete using Photon (free OSM-based geocoder)
  // Greater Birmingham Metro Area bounding box (7-county MSA)
  const BIRMINGHAM_BBOX = { minLat: 32.6, maxLat: 34.2, minLng: -87.5, maxLng: -86.0 };

  let debounceTimer: ReturnType<typeof setTimeout>;

  addressInput.addEventListener('input', () => {
    clearTimeout(debounceTimer);
    const query = addressInput.value.trim();

    if (query.length < 3) {
      addressSuggestions.classList.add('hidden');
      return;
    }

    debounceTimer = setTimeout(async () => {
      try {
        // Photon API with Birmingham bias
        const url = `https://photon.komoot.io/api/?q=${encodeURIComponent(query)}&lat=33.52&lon=-86.81&limit=5`;
        const res = await fetch(url);
        const data = await res.json();

        // Filter to Birmingham area only
        const filtered = data.features?.filter((f: any) => {
          const [lng, lat] = f.geometry.coordinates;
          return lat >= BIRMINGHAM_BBOX.minLat && lat <= BIRMINGHAM_BBOX.maxLat &&
                 lng >= BIRMINGHAM_BBOX.minLng && lng <= BIRMINGHAM_BBOX.maxLng;
        }) || [];

        if (filtered.length === 0) {
          addressSuggestions.classList.add('hidden');
          return;
        }

        // Render suggestions
        addressSuggestions.innerHTML = filtered.map((f: any) => {
          const props = f.properties;
          const street = props.street || '';
          const housenumber = props.housenumber || '';
          const city = props.city || props.locality || '';
          const postcode = props.postcode || '';
          const display = housenumber ? `${housenumber} ${street}` : street;

          return `<div class="px-4 py-2 hover:bg-slate-700 cursor-pointer text-sm"
                       data-street="${display}"
                       data-city="${city}"
                       data-zip="${postcode}">
                    <div class="font-medium">${display}</div>
                    <div class="text-slate-400 text-xs">${city}${postcode ? ', ' + postcode : ''}</div>
                  </div>`;
        }).join('');

        addressSuggestions.classList.remove('hidden');
      } catch (err) {
        console.error('Autocomplete error:', err);
      }
    }, 300);
  });

  // Handle suggestion click
  addressSuggestions.addEventListener('click', (e) => {
    const item = (e.target as HTMLElement).closest('[data-street]') as HTMLElement;
    if (!item) return;

    const street = item.dataset.street || '';
    const city = item.dataset.city || '';
    const zip = item.dataset.zip || '';

    addressInput.value = street;

    // Try to match city
    const cityOption = Array.from(citySelect.options).find(o =>
      o.value.toLowerCase() === city.toLowerCase()
    );
    if (cityOption) {
      citySelect.value = cityOption.value;
    }

    // Try to match ZIP
    if (zip) {
      const zipOption = Array.from(zipSelect.options).find(o => o.value === zip);
      if (zipOption) {
        zipSelect.value = zip;
      }
    }

    addressSuggestions.classList.add('hidden');
  });

  // Hide suggestions on click outside
  document.addEventListener('click', (e) => {
    if (!addressSuggestions.contains(e.target as Node) && e.target !== addressInput) {
      addressSuggestions.classList.add('hidden');
    }
  });

  // Photo preview on file select
  photosInput.addEventListener('change', () => {
    const files = photosInput.files;
    if (!files || files.length === 0) {
      photoPreview.classList.add('hidden');
      return;
    }

    // Validate file count
    if (files.length > 5) {
      alert('Please select up to 5 photos only.');
      photosInput.value = '';
      return;
    }

    // Show previews
    photoPreview.innerHTML = '';
    photoPreview.classList.remove('hidden');

    Array.from(files).forEach((file) => {
      const reader = new FileReader();
      reader.onload = (e) => {
        const img = document.createElement('img');
        img.src = e.target?.result as string;
        img.className = 'w-full h-24 object-cover rounded-lg';
        photoPreview.appendChild(img);
      };
      reader.readAsDataURL(file);
    });
  });

  // Form submission
  form.addEventListener('submit', async (e) => {
    e.preventDefault();

    // Reset messages
    successMsg.classList.add('hidden');
    errorMsg.classList.add('hidden');

    // Show progress, hide form
    progressContainer.classList.remove('hidden');
    submitBtn.disabled = true;
    submitBtn.classList.add('hidden');
    updateProgress('Preparing submission...', 5);

    try {
      // First, upload photos
      const photos = photosInput.files;
      if (!photos || photos.length === 0) {
        throw new Error('Please select at least one photo');
      }

      const photoUrls: string[] = [];
      const totalPhotos = photos.length;

      for (let i = 0; i < totalPhotos; i++) {
        const photo = photos[i];
        const photoNum = i + 1;

        updateProgress(
          `Uploading photo ${photoNum} of ${totalPhotos}...`,
          10 + (photoNum / totalPhotos) * 60,
          photo.name
        );

        const formData = new FormData();
        formData.append('file', photo);

        const uploadRes = await fetch('/api/upload', {
          method: 'POST',
          body: formData,
        });

        if (!uploadRes.ok) {
          const err = await uploadRes.json();
          throw new Error(err.error || `Failed to upload photo ${photoNum}`);
        }

        const { url } = await uploadRes.json();
        photoUrls.push(url);
      }

      updateProgress('Finding your address on the map...', 75);

      // Collect form data
      const formData = new FormData(form);
      const features = formData.getAll('features') as string[];

      // Build bestTimes from selectors
      const lightsOn = formData.get('lightsOn') as string;
      const lightsOff = formData.get('lightsOff') as string;
      const schedule = formData.get('schedule') as string;

      let bestTimes: string | null = null;
      if (lightsOn && lightsOff) {
        const scheduleText = schedule === 'nightly' ? 'nightly' :
                            schedule === 'weekends' ? 'weekends only' :
                            schedule === 'fri-sun' ? 'Fri-Sun' :
                            'varies';
        bestTimes = `${lightsOn} - ${lightsOff}, ${scheduleText}`;
      }

      const contributorType = formData.get('contributorType') as string;

      const submitData = {
        address: formData.get('address'),
        unit: formData.get('unit') || null,
        city: formData.get('city'),
        zip: formData.get('zip'),
        neighborhood: formData.get('neighborhood') || null,
        displayName: formData.get('displayName') || null,
        description: formData.get('description') || null,
        bestTimes,
        contributorType,
        features,
        photoUrls,
        // Include userId if user is owner and logged in
        ownerId: contributorType === 'owner' && userId ? userId : null,
      };

      updateProgress('Submitting your display...', 90);

      // Submit property
      const submitRes = await fetch('/api/submit', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify(submitData),
      });

      if (!submitRes.ok) {
        const err = await submitRes.json();
        throw new Error(err.error || 'Failed to submit property');
      }

      updateProgress('Done!', 100);

      // Success! Show success message after brief delay
      await new Promise(resolve => setTimeout(resolve, 500));
      form.classList.add('hidden');
      progressContainer.classList.add('hidden');
      successMsg.classList.remove('hidden');
      window.scrollTo({ top: 0, behavior: 'smooth' });

    } catch (err) {
      // Show error, restore form
      progressContainer.classList.add('hidden');
      errorText.textContent = err instanceof Error ? err.message : 'Something went wrong';
      errorMsg.classList.remove('hidden');
      submitBtn.disabled = false;
      submitBtn.classList.remove('hidden');
      window.scrollTo({ top: 0, behavior: 'smooth' });
    }
  });
</script>
