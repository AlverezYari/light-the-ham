---
/**
 * Rankings Page - /rankings
 * Coming soon placeholder for display rankings/leaderboard
 */
export const prerender = false;

import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout title="Rankings | Light the Ham!">
  <div class="min-h-[60vh] flex items-center justify-center px-4">
    <div class="text-center max-w-md">
      <div class="text-8xl mb-6">🏆</div>
      <h1 class="text-3xl font-bold mb-4">Rankings Coming Soon!</h1>
      <p class="text-slate-400 mb-8">
        We're tallying up the votes and ratings. Check back soon to see which displays
        are lighting up Birmingham the brightest!
      </p>
      <div class="space-y-3">
        <a
          href="/"
          class="block bg-amber-500 hover:bg-amber-600 text-slate-900 font-semibold py-3 px-6 rounded-lg transition-colors"
        >
          Explore the Map
        </a>
        <a
          href="/submit"
          class="block bg-slate-700 hover:bg-slate-600 text-white font-semibold py-3 px-6 rounded-lg transition-colors"
        >
          Submit a Display
        </a>
      </div>
    </div>
  </div>
</BaseLayout>
