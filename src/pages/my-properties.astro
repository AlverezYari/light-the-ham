---
/**
 * My Properties Page - "/my-properties"
 *
 * Shows properties owned by the logged-in user.
 */
export const prerender = false;

import BaseLayout from '../layouts/BaseLayout.astro';
import { db, properties, propertyClaims } from '../lib/db';
import { eq, or } from 'drizzle-orm';
import { validateSession, getSessionFromCookies } from '../lib/auth';

// Check authentication
const cookieHeader = Astro.request.headers.get('cookie');
const sessionToken = getSessionFromCookies(cookieHeader);
const session = sessionToken ? await validateSession(sessionToken) : null;
const user = session?.user || null;

// Redirect if not logged in
if (!user) {
  return Astro.redirect('/login?redirect=/my-properties');
}

// Fetch properties owned by user
const ownedProperties = await db
  .select()
  .from(properties)
  .where(eq(properties.ownerId, user.id))
  .orderBy(properties.createdAt);

// Fetch pending claims by user
const pendingClaims = await db
  .select({
    id: propertyClaims.id,
    status: propertyClaims.status,
    createdAt: propertyClaims.createdAt,
    propertyId: propertyClaims.propertyId,
    propertyAddress: properties.address,
    propertyCity: properties.city,
  })
  .from(propertyClaims)
  .innerJoin(properties, eq(propertyClaims.propertyId, properties.id))
  .where(
    eq(propertyClaims.userId, user.id)
  )
  .orderBy(propertyClaims.createdAt);

// Filter to only pending/disputed claims
const activeClaims = pendingClaims.filter(c => c.status === 'pending' || c.status === 'disputed');
---

<BaseLayout title="My Properties | Light the Ham!">
  <div class="mx-auto max-w-4xl px-4 py-8">
    <h1 class="text-3xl font-bold text-amber-400 mb-2">My Properties</h1>
    <p class="text-slate-400 mb-8">Properties you own and pending claims</p>

    <!-- Owned Properties -->
    <section class="mb-10">
      <h2 class="text-xl font-semibold mb-4 border-b border-slate-700 pb-2">
        Owned Properties ({ownedProperties.length})
      </h2>

      {ownedProperties.length === 0 ? (
        <div class="bg-slate-800 rounded-lg p-6 text-center">
          <p class="text-slate-400 mb-4">You don't own any properties yet.</p>
          <p class="text-sm text-slate-500">
            Find a property on the <a href="/map" class="text-amber-400 hover:text-amber-300">map</a> and claim it if it's yours!
          </p>
        </div>
      ) : (
        <div class="space-y-4">
          {ownedProperties.map((prop) => (
            <a
              href={`/properties/${prop.id}`}
              class="block bg-slate-800 hover:bg-slate-700 rounded-lg p-4 transition-colors"
            >
              <div class="flex justify-between items-start">
                <div>
                  <h3 class="text-lg font-medium text-amber-400">
                    {prop.displayName || prop.address}
                  </h3>
                  {prop.displayName && (
                    <p class="text-sm text-slate-400">{prop.address}</p>
                  )}
                  <p class="text-sm text-slate-500">{prop.city}, {prop.state} {prop.zip}</p>
                </div>
                <div class="text-right">
                  <div class="flex items-center gap-1 text-amber-400">
                    {[1, 2, 3, 4, 5].map((star) => (
                      <span class={`text-sm ${(prop.avgRating || 0) >= star ? 'opacity-100' : 'opacity-30'}`}>
                        🔥
                      </span>
                    ))}
                  </div>
                  <p class="text-xs text-slate-500 mt-1">
                    {prop.ratingCount || 0} ratings
                  </p>
                  <span class={`inline-block mt-2 text-xs px-2 py-0.5 rounded ${
                    prop.status === 'approved' ? 'bg-green-500/20 text-green-400' :
                    prop.status === 'pending' ? 'bg-amber-500/20 text-amber-400' :
                    'bg-slate-600 text-slate-400'
                  }`}>
                    {prop.status}
                  </span>
                </div>
              </div>
            </a>
          ))}
        </div>
      )}
    </section>

    <!-- Pending Claims -->
    {activeClaims.length > 0 && (
      <section class="mb-10">
        <h2 class="text-xl font-semibold mb-4 border-b border-slate-700 pb-2">
          Pending Claims ({activeClaims.length})
        </h2>

        <div class="space-y-4">
          {activeClaims.map((claim) => (
            <div class={`rounded-lg p-4 ${
              claim.status === 'disputed'
                ? 'bg-amber-500/10 border border-amber-500/30'
                : 'bg-slate-800'
            }`}>
              <div class="flex justify-between items-center">
                <div>
                  <a
                    href={`/properties/${claim.propertyId}`}
                    class="text-lg font-medium text-amber-400 hover:text-amber-300"
                  >
                    {claim.propertyAddress}, {claim.propertyCity}
                  </a>
                  <p class="text-sm text-slate-500 mt-1">
                    Claimed on {new Date(claim.createdAt!).toLocaleDateString()}
                  </p>
                </div>
                <span class={`text-sm px-3 py-1 rounded-full ${
                  claim.status === 'disputed'
                    ? 'bg-amber-500/20 text-amber-400'
                    : 'bg-blue-500/20 text-blue-400'
                }`}>
                  {claim.status === 'disputed' ? 'Under Review' : 'Pending'}
                </span>
              </div>
              {claim.status === 'disputed' && (
                <p class="text-xs text-slate-500 mt-2">
                  This property has another owner. An admin will review your claim.
                </p>
              )}
            </div>
          ))}
        </div>
      </section>
    )}

    <!-- Quick Actions -->
    <section>
      <h2 class="text-xl font-semibold mb-4 border-b border-slate-700 pb-2">Quick Actions</h2>
      <div class="flex gap-4">
        <a
          href="/submit"
          class="bg-amber-500 hover:bg-amber-600 text-slate-900 font-medium py-2 px-6 rounded-lg transition-colors"
        >
          Submit New Property
        </a>
        <a
          href="/map"
          class="bg-slate-700 hover:bg-slate-600 text-white font-medium py-2 px-6 rounded-lg transition-colors"
        >
          Browse Map
        </a>
      </div>
    </section>
  </div>
</BaseLayout>
